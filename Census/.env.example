# Inert example. Copy to Census/.env locally and replace fields with authorized environment-specific values.
# Never commit a real .env or personal/network information.
POSTGRES_USER=census_dev
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=census_dev
AD_SERVER_URL=ldaps://ad.example.invalid
AD_BIND_USER=service@example.invalid
AD_BIND_PASSWORD=
AD_SEARCH_BASE=DC=example,DC=invalid
AXLERATE_BASE_URL=http://127.0.0.1:8001
APP_NAME=Census
APP_VERSION=0.0.0-dev
DEBUG=false
API_PREFIX=/api
SECRET_KEY=
LOG_LEVEL=INFO
SCHEDULER_ENABLED=false
LOCAL_SUBNET_PREFIX=192.0.2.
DAILY_SYNC_HOUR=2
DAILY_SYNC_MINUTE=0
MAX_DB_POOL_SIZE=5
MAX_DB_OVERFLOW=5
HTTP_TIMEOUT_SECONDS=30
SCRAPER_MAX_CONCURRENT=2
